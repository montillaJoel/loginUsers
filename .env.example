# Copia este archivo como .env y pon tus propios valores.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# MySQL instalado en tu PC (puerto por defecto 3306)
loginUsers_DB_URL=jdbc:mysql://localhost:3306/loginUsers
# Si usas Docker (docker-compose.yml), usa el puerto 3307:
# loginUsers_DB_URL=jdbc:mysql://localhost:3307/loginUsers

loginUsers_DB_USUARIO=root
loginUsers_DB_CLAVE=tu_clave_aqui
